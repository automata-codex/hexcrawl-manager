---
import Clock from './Clock.astro';
import FactionNpcList from './FactionNpcList.svelte';
import { renderMarkdown } from '../utils/markdown';
import { formatText } from '../utils/text';

import type { FactionData } from '@achm/schemas';
import type { NpcListItem } from './npc-list-types';

interface Props {
  faction: FactionData;
  /** Curated featured representatives projected from `faction.activeAgents`
   * (with `role` and possibly stub rows when `npcId` is absent). */
  activeAgents?: NpcListItem[];
  /** Comprehensive query-derived list of NPCs whose `factions` array contains
   * this faction id, minus anyone already in `activeAgents`. */
  associatedNpcs?: NpcListItem[];
}

const { faction, activeAgents = [], associatedNpcs = [] } = Astro.props;

const activeAgentCount = activeAgents.filter(
  (npc) => npc.campaignStatus === 'active',
).length;
const associatedActiveCount = associatedNpcs.filter(
  (npc) => npc.campaignStatus === 'active',
).length;
---

<style>
  .quote {
    font-style: italic;
    margin: 0 10% 1rem;
  }
</style>
<section>
  {faction.quote && (
    <div class="quote">
      <Fragment set:html={renderMarkdown(faction.quote)} />
    </div>
  )}
  {activeAgentCount > 0 && (
    <>
      <h3 class="title is-5">Active Agents</h3>
      <FactionNpcList
        client:load
        npcs={activeAgents}
        urlKey="show-inactive-agents"
      />
    </>
  )}
  {associatedActiveCount > 0 && (
    <>
      <h3 class="title is-5">
        {activeAgentCount > 0 ? 'Other Associated NPCs' : 'Associated NPCs'}
      </h3>
      <FactionNpcList
        client:load
        npcs={associatedNpcs}
        urlKey="show-inactive-associated"
      />
    </>
  )}
  <div>
    <Fragment set:html={renderMarkdown(faction.description)} />
  </div>
  <h3 class="title is-5">Ideology</h3>
  <div>
    <Fragment set:html={renderMarkdown(faction.ideology)} />
  </div>
  <h3 class="title is-5">Power Level</h3>
  <div>
    <Fragment set:html={renderMarkdown(faction.powerLevel)} />
  </div>
  <h3 class="title is-5">Areas of Operation</h3>
  <div>
    <ul>
      {faction.areaOfOperation.map((area) => <li><Fragment set:html={renderMarkdown(area)} /></li>)}
    </ul>
  </div>
  {faction.goals && (
    <>
      <h3 class="title is-5">Goals</h3>
      <div>
        <Fragment set:html={renderMarkdown(faction.goals)} />
      </div>
    </>
  )}
  {faction.clocks && faction.clocks.length > 0 && (
    <>
      <h3 class="title is-5">Clocks</h3>
      <div>
        {faction.clocks.map((clock) => (
          <Clock
            title={clock.title}
            totalSteps={clock.totalSteps}
            completedSteps={clock.completedSteps}
            description={clock.description}
          />
        ))}
      </div>
    </>
  )}
  {faction.ifIgnored && (
    <>
      <h3 class="title is-5">If Ignored</h3>
      <div>
        <Fragment set:html={renderMarkdown(faction.ifIgnored)} />
      </div>
    </>
  )}
  {faction.pcIntersections && (
    <>
      <h3 class="title is-5">PC Intersections</h3>
      <div>
        <Fragment set:html={renderMarkdown(faction.pcIntersections)} />
      </div>
    </>
  )}
</section>
