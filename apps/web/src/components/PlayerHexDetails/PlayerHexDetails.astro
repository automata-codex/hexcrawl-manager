---
import {
  LOST_VALLEY_BARRIER_PLAYER_MESSAGE,
  LOST_VALLEY_BARRIER_TAG,
} from '../../utils/constants.ts';

import Explored from './Explored.astro';
import HiddenSites from './HiddenSites.astro';
import Landmark from './Landmark.astro';
import Neighbors from './Neighbors.astro';
import Visited from './Visited.astro';

import type { HexData } from '@achm/schemas';

interface Props {
  hex: HexData;
}

const { hex } = Astro.props;
---

<style>
  .warning {
    background-color: var(--bulma-danger);
    color: var(--bulma-white);
    font-weight: bold;
    padding: 1rem;
    text-align: center;
    margin: 0 0 1rem;
  }

  .data-bar {
    display: flex;
    font-weight: bold;

    div {
      margin-right: 1rem;
    }
  }
</style>

<section>
  {
    (hex.isVisited || hex.isScouted) &&
      hex.tags?.includes(LOST_VALLEY_BARRIER_TAG) && (
        <p class="warning">{LOST_VALLEY_BARRIER_PLAYER_MESSAGE}</p>
      )
  }
  <div class="data-bar">
    <Visited hex={hex} />
    <Explored hex={hex} />
  </div>
  <div class="data-bar">
    <Neighbors hex={hex} />
  </div>
  {hex.topography && (
    <p class="hanging-indent">
      <span class="inline-heading">Topography:</span>
      {' '}
      {hex.topography}
    </p>
  )}
  <Landmark hex={hex} />
  <HiddenSites hex={hex} />
</section>
