---
import { isActive } from '@achm/schemas';
import { getEntry } from 'astro:content';

import Badge from '../../../components/Badge.astro';
import Faction from '../../../components/Faction.astro';
import SecretLayout from '../../../layouts/SecretLayout.astro';

const { id } = Astro.params;
if (!id) {
  return new Response(null, {
    status: 404,
    statusText: 'Not found',
  });
}

const factionData = await getEntry('factions', id);

if (factionData === undefined) {
  return new Response(null, {
    status: 404,
    statusText: 'Not found',
  });
}

const faction = factionData.data;
---

<style>
  .status-indicator {
    margin-bottom: 1rem;
  }
</style>

<SecretLayout title={faction.name}>
  {!isActive(faction) && (
    <p class="status-indicator">
      <Badge color="gray">Inactive</Badge>
    </p>
  )}
  <Faction faction={faction} />
</SecretLayout>
