---
import { getCollection } from 'astro:content';

import { renderMarkdown } from '../../../utils/markdown';
import { formatText } from '../../../utils/text';
import SecretLayout from '../../../layouts/SecretLayout.astro';

const factionData = await getCollection('factions');
const factions = factionData
  .map((entry) => entry.data)
  .sort((a, b) => a.name.localeCompare(b.name));
---

<style>
  .faction-summary {
    margin-bottom: 1.5rem;
  }

  .faction-quote {
    font-style: italic;
    margin: 0 10% 0.5rem;
  }

  .faction-ideology {
    margin-bottom: 0.5rem;
  }

  .faction-link {
    color: inherit;
    text-decoration: none;
  }

  .faction-link:hover {
    text-decoration: underline;
  }
</style>
<SecretLayout title="Factions">
  {factions.map((faction) => (
    <div class="faction-summary">
      <h2 class="title is-3">
        <a class="faction-link" href={`/gm-reference/factions/${faction.id}`}>{formatText(faction.name)}</a>
      </h2>
      {faction.quote && (
        <div class="faction-quote">
          <Fragment set:html={renderMarkdown(faction.quote)} />
        </div>
      )}
      <div class="faction-ideology">
        <Fragment set:html={renderMarkdown(faction.ideology)} />
      </div>
    </div>
  ))}
</SecretLayout>
