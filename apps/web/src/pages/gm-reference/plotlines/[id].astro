---
import { sortIgnoringArticles } from '@achm/core';
import { isActive } from '@achm/schemas';
import { getCollection, render } from 'astro:content';

import Badge from '../../../components/Badge.astro';
import PlotlineBeatList from '../../../components/PlotlineBeatList.astro';
import type { BeatListItem } from '../../../components/PlotlineBeatList.types';
import { getCluePath } from '../../../config/routes';
import SecretLayout from '../../../layouts/SecretLayout.astro';

// Get the ID from the incoming server request
const { id } = Astro.params;
if (!id) {
  return new Response(null, {
    status: 404,
    statusText: 'Not found',
  });
}

// Query for the entry by slug
const plotlines = await getCollection('plotlines');
const plotline = plotlines.find((p) => p.data.slug === id);

// Redirect if the entry does not exist
if (plotline === undefined) {
  return new Response(null, {
    status: 404,
    statusText: 'Not found',
  });
}

// Get clues linked to this plotline (back-reference list)
const allClues = await getCollection('clues');
const linkedClues = allClues
  .filter((c) => c.data.plotlines?.includes(plotline.data.slug))
  .map((c) => ({ id: c.id, name: c.data.name, status: c.data.status }))
  .sort((a, b) => sortIgnoringArticles(a.name, b.name));

// Resolve beat references in declared order. The ordered `beatRefs` array
// on the plotline is the canonical sequence; the beats collection carries
// the per-beat content.
const allBeats = await getCollection('beats');
const beatsBySlug = new Map(
  allBeats
    .filter((b) => b.data.plotline === plotline.data.slug)
    .map((b) => [b.data.slug, b.data]),
);
const beatItems: BeatListItem[] = (plotline.data.beatRefs ?? []).map((slug) => {
  const beat = beatsBySlug.get(slug);
  if (!beat) return { found: false, slug };
  return {
    found: true,
    slug,
    title: beat.title,
    status: beat.status,
    trigger: beat.trigger,
  };
});

const { Content } = await render(plotline);
const title = plotline.data.title;
---
<style is:global>
  h3 > a {
    color: inherit;
    text-decoration: none;
  }

  h3 > a:hover {
    text-decoration: underline;
  }

</style>

<SecretLayout title={title}>
  {!isActive(plotline.data) && (
    <p class="status-indicator">
      <Badge color="gray">Inactive</Badge>
    </p>
  )}
  <div class="clue-header">
    <p><strong>Status:</strong>{' '}{plotline.data.status}</p>
    {plotline.data.summary && <p class="hanging-indent"><strong>Summary:</strong>{' '}{plotline.data.summary}</p>}
    {linkedClues.length > 0 && (
      <>
        <p><strong>Clues:</strong></p>
        <ul class="linked-clues">
          {linkedClues.map((clue) => (
            <li>
              <a href={getCluePath(clue.id)}>{clue.name}</a>
              {clue.status === 'known' && <span class="checkmark">✓</span>}
            </li>
          ))}
        </ul>
      </>
    )}
  </div>
  <PlotlineBeatList plotlineSlug={plotline.data.slug} items={beatItems} />
  <Content />
</SecretLayout>

<style>
  .status-indicator {
    margin-bottom: 1rem;
  }

  .clue-header {
    margin-bottom: 1rem;

    p {
      margin-bottom: 0;
      margin-top: 0;
    }

    ul {
      margin: 0;
    }
  }

  .linked-clues {
    margin-top: 0.5rem;
    margin-bottom: 1rem;
  }

  .checkmark {
    color: var(--bulma-success);
    margin-left: 0.25rem;
    font-weight: bold;
  }
</style>
