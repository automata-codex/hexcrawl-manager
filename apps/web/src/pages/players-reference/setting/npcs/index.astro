---
import { getNpcSortKey } from '@achm/schemas';
import { getCollection } from 'astro:content';

import NpcList from '../../../../components/NpcList.svelte';
import { getNpcPath } from '../../../../config/routes.ts';
import ComponentLayout from '../../../../layouts/ComponentLayout.astro';

function formatOccupation(
  occupation: string,
  charClass?: string,
  adventuringCompany?: string,
) {
  if (occupation === 'Adventurer') {
    if (adventuringCompany) {
      return `Adventurer (${charClass}), ${adventuringCompany}`;
    }
    return `Adventurer (${charClass})`;
  }
  return occupation;
}

const [npcEntries, factionEntries, plotlineEntries] = await Promise.all([
  getCollection('npcs'),
  getCollection('factions'),
  getCollection('plotlines'),
]);

const factionNames: Record<string, string> = Object.fromEntries(
  factionEntries.map((f) => [f.id, f.data.name]),
);
const plotlineNames: Record<string, string> = Object.fromEntries(
  plotlineEntries.map((p) => [p.id, p.data.title]),
);

// TODO(npc-status): once `hidden` / `inactive` flags land on the NPC schema,
// drop hidden NPCs from this list and add a GM-only toggle for inactive ones.
// See docs/specs/npc-schema-update-and-filterable-index.md §"Status filtering".
const npcs = npcEntries
  .map((entry) => ({
    id: entry.id,
    href: getNpcPath(entry.id),
    displayName: entry.data.displayName,
    sortKey: getNpcSortKey(entry.data),
    occupation: formatOccupation(
      entry.data.occupation,
      entry.data.class,
      entry.data.adventuringCompany,
    ),
    image: entry.data.image,
    factions: entry.data.factions ?? [],
    plotlines: entry.data.plotlines ?? [],
  }))
  .sort((a, b) =>
    a.sortKey.localeCompare(b.sortKey, undefined, { sensitivity: 'base' }),
  );

const filterOptions = {
  factions: [...new Set(npcs.flatMap((n) => n.factions))].sort((a, b) =>
    (factionNames[a] ?? a).localeCompare(factionNames[b] ?? b, undefined, {
      sensitivity: 'base',
    }),
  ),
  plotlines: [...new Set(npcs.flatMap((n) => n.plotlines))].sort((a, b) =>
    (plotlineNames[a] ?? a).localeCompare(plotlineNames[b] ?? b, undefined, {
      sensitivity: 'base',
    }),
  ),
};
---

<ComponentLayout title="NPCs">
  <main>
    <NpcList
      client:load
      npcs={npcs}
      filterOptions={filterOptions}
      factionNames={factionNames}
      plotlineNames={plotlineNames}
    />
  </main>
</ComponentLayout>
